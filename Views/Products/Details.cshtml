@model SimpleShop.Models.Product

@{
    ViewData["Title"] = "Детали товара";
}

@{
    var placeholderImage = Url.Content("~/images/product-placeholder.svg");
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) ? placeholderImage : Model.ImageUrl;
}

<div class="row gy-4">
    <div class="col-md-6">
        <img src="@imageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Name" />
    </div>
    <div class="col-md-6">
        <p class="text-muted">@Model.Category?.Name</p>
        <h2>@Model.Name</h2>
        <p class="lead">@Model.ShortDescription</p>
        <p>@Model.Description</p>
        <p class="display-6">@Model.Price.ToString("C")</p>
        <p class="fw-semibold @(Model.Stock > 0 ? "text-success" : "text-danger")">
            @(Model.Stock > 0 ? $"В наличии: {Model.Stock}" : "Нет в наличии")
        </p>

        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="mb-3">
                <label for="qty" class="form-label">Количество</label>
                <input type="number" id="qty" name="qty" value="1" min="1" max="@Model.Stock" class="form-control" style="max-width:200px" @(Model.Stock <= 0 ? "disabled" : string.Empty) />
            </div>
            <button type="submit" class="btn btn-success me-2" @(Model.Stock <= 0 ? "disabled" : string.Empty)>
                Добавить в корзину
            </button>
            <a asp-controller="Products" asp-action="Category" class="btn btn-secondary">Назад к витрине</a>
        </form>
    </div>
</div>


