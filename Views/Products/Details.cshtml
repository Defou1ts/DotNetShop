@model SimpleShop.Models.Product

@{
    ViewData["Title"] = "Детали товара";
}

<h2>@Model.Name</h2>

<dl class="row">
    <dt class="col-sm-3">Категория</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Цена</dt>
    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
    <input type="hidden" name="productId" value="@Model.Id" />
    <div class="mb-3">
        <label for="qty" class="form-label">Количество</label>
        <input type="number" id="qty" name="qty" value="1" min="1" max="@Model.Stock" class="form-control" style="width:150px" />
    </div>
    <button type="submit" class="btn btn-success">Добавить в корзину</button>
    <a asp-controller="Products" asp-action="Category" class="btn btn-secondary">Назад к витрине</a>
</form>


